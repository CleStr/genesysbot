# gEneSysBot backend environment variables (optional).
# Copy to .env and adjust as needed.

# Admin password that protects the setup screen. Use a unique, strong value.
ADMIN_PASSWORD=replace-with-a-unique-long-password

# Pre-configure an API key here instead of entering it via the setup screen.
# FHG_API_KEY=

# Base URL of the Fraunhofer chat completions API (OpenAI-compatible).
# FHG_BASE_URL=https://api.fhg.example.com/v1

PORT=3001
