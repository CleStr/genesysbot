# gEneSysBot backend environment variables (optional).
# Copy to .env and adjust as needed.

# Admin password that protects the setup screen. Use a unique, strong value.
# REQUIRED in production. The server refuses to start without it unless
# ALLOW_INSECURE_LOCAL_DEV=true is set (non-production only).
ADMIN_PASSWORD=replace-with-a-unique-long-password

# Local development only: when "true" (and NODE_ENV is not "production"),
# allows starting without ADMIN_PASSWORD and binds the server to 127.0.0.1
# only. Never enable this in production.
# ALLOW_INSECURE_LOCAL_DEV=true

# Set to "1" or "true" when running behind a reverse proxy (e.g. Render),
# so rate limiting trusts X-Forwarded-For headers. Leave unset for local dev.
# TRUST_PROXY=1

# Pre-configure an API key here instead of entering it via the setup screen.
# FHG_API_KEY=

# Base URL of the Fraunhofer chat completions API (OpenAI-compatible).
# FHG_BASE_URL=https://api.fhg.example.com/v1

PORT=3001
